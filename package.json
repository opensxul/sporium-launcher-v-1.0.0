{
  "name": "sporium",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --debug --no-bundle",
    "installer:build": "node scripts/build-installer.mjs",
    "brand:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-brand-icons.ps1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:native": "node scripts/native-smoke.mjs",
    "test:polish-native": "node scripts/ui-polish-native-smoke.mjs",
    "test:game-native": "node scripts/game-native-smoke.mjs",
    "test:modded-native": "node scripts/modded-native-smoke.mjs",
    "test:download-native": "node scripts/download-native-smoke.mjs",
    "test:modrinth-native": "node scripts/modrinth-native-smoke.mjs",
    "test:local-native": "node scripts/local-content-native-smoke.mjs",
    "test:update-native": "node scripts/content-update-native-smoke.mjs",
    "test:adoption-native": "node scripts/content-adoption-native-smoke.mjs",
    "test:diagnostics-native": "node scripts/content-diagnostics-native-smoke.mjs",
    "test:world-native": "node scripts/world-content-native-smoke.mjs",
    "test:mixed-game-native": "node scripts/mixed-content-game-smoke.mjs",
    "test:pack-native": "node scripts/pack-native-smoke.mjs",
    "test:restore-native": "node scripts/content-restore-native-smoke.mjs",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-tools --bin export-bindings",
    "bindings:check": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-tools --bin export-bindings -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
